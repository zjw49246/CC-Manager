# Required for every Worker node; Workers refuse legacy auth-disabled mode.
AUTH_TOKEN=your-secret-token-here

# 飞书 OAuth（STATE_SECRET 可留空并复用 FEISHU_APP_SECRET）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OAUTH_STATE_SECRET=       # 可选独立部署密钥；建议 32+ 随机字符
FEISHU_OAUTH_STATE_TTL_SECONDS=600

# 注册验证码邮件（可选；未配置时 /api/auth/send-code 会明确失败）
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 验证码状态和发送限流（单进程内存；多副本部署应在网关再加全局限流）
VERIFICATION_CODE_CAPACITY=4096
VERIFICATION_CODE_RATE_WINDOW_SECONDS=600
VERIFICATION_CODE_EMAIL_LIMIT=5
VERIFICATION_CODE_IP_LIMIT=30
VERIFICATION_CODE_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_CODE_SMTP_CONCURRENCY=4
OPENAI_API_KEY=sk-...           # 语音功能所需（可选）
DATABASE_URL=sqlite+aiosqlite:///./claude_manager.db
WORKSPACE_DIR=~/Projects
# Persistent /api/uploads storage hard cap (default 2 GiB across all files).
UPLOAD_MAX_TOTAL_BYTES=2147483648
# Separate inode guard; zero-byte uploads still consume one file slot.
UPLOAD_MAX_TOTAL_FILES=10000
CLAUDE_BINARY=claude
CODEX_BINARY=codex
# Codex 0.147 自定义 permission profile 的已知响应兼容；不关闭实际沙箱。
CODEX_SANDBOX_RESPONSE_COMPAT_ENABLED=true
DEFAULT_PROVIDER=codex          # codex | claude
PROVIDER_OPTIONS=claude,codex
DEFAULT_CODEX_MODEL=gpt-5.6-sol
CODEX_MODEL_OPTIONS=default,gpt-6-astra,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.3-codex-spark
# Plan 两层模型默认值；每个 Plan 创建时会固化完整 primary/fallback 快照
PLAN_PLANNER_PROVIDER=claude
PLAN_PLANNER_MODEL=claude-fable-5
PLAN_PLANNER_EFFORT=high
PLAN_PLANNER_FALLBACK_PROVIDER=codex
PLAN_PLANNER_FALLBACK_MODEL=gpt-5.6-terra
PLAN_PLANNER_FALLBACK_EFFORT=xhigh
PLAN_REVIEWER_ENABLED=true
PLAN_REVIEWER_PROVIDER=codex
PLAN_REVIEWER_MODEL=gpt-5.6-sol
PLAN_REVIEWER_EFFORT=xhigh
PLAN_REVIEWER_FALLBACK_PROVIDER=claude
PLAN_REVIEWER_FALLBACK_MODEL=claude-sonnet-5
PLAN_REVIEWER_FALLBACK_EFFORT=high
PLAN_MAX_REVISION_CYCLES=2
PLAN_STRUCTURED_OUTPUT_WHITESPACE_LIMIT=4096
# Capability admission switches default on and can be disabled independently.
# Auto also requires Capability Core plus an explicit per-Task policy;
# Delivery has its own controller gate and freezes the selected PR Monitor's
# ready-to-merge or direct-auto-merge terminal policy at admission.
CAPABILITY_CORE_ENABLED=true
AUTO_CAPABILITY_ENABLED=true
DELIVERY_LOOP_ENABLED=true
CODEX_MAIN_MCP_ENABLED=true     # 默认启用；紧急回退可显式设为 false
CODEX_POOL_ENABLED=true         # 部署级总开关；日常路由策略在 Pro → Codex → 设置中修改
CODEX_POOL_CONFIG_PATH=~/.codex-pool/accounts.json
CODEX_POOL_COOLDOWN_SECONDS=300 # 旧配置尚未保存在线策略时的默认值
AUTO_START_DISPATCHER=true
MERGE_PUSH_RETRIES=3
AUTO_PUSH_TO_ORIGIN=true
CLAUDE_PTY_RESPONSE_IDLE_TIMEOUT_SECONDS=900  # PTY 无活动超时（秒）；工具/子 Agent 有进展时自动续期，超长工具可显式调大
PORT=8000                       # 主服务端口（默认 8000）
CLOUDROUTER_ACCOUNTS_DIR=~/.ccm/api-accounts  # CloudRouter API 账号独立目录（每把 Key 一个 0700 子目录）
SSH_KEY_STORAGE_DIR=~/.ccm/ssh-keys           # SSH 页面上传私钥的 0700/0600 后端托管目录

# ── 账号自动登录浏览器运行时 ─────────────────────────────────────────────
# 同一台机器运行多套 CCM 时，每套必须使用不同的 DISPLAY。
# Chrome CDP 使用每次登录 profile 内的 DevToolsActivePort 动态分配和绑定，
# 不再配置或复用固定端口。
CCM_XVFB_DISPLAY=:99
CCM_LOGIN_TMPDIR=~/.cache/ccm/login-tmp  # 使用磁盘目录，避免 RAM-backed /tmp
CCM_LOGIN_MIN_AVAILABLE_MB=512           # 低于阈值时拒绝启动 Chrome
CCM_LOGIN_MIN_TEMP_FREE_MB=512

# ── 宿主与共享 Docker /tmp 临时空间保护 ─────────────────────────────
# 容量或 inode 任一达到 80% 时，清理全部超过最小年龄的 CCM 白名单产物；
# 未知文件和 /tmp/ccm-update-* 始终保留。
TMP_CLEANUP_ENABLED=true
TMP_CLEANUP_USAGE_THRESHOLD=0.80
TMP_CLEANUP_INTERVAL_SECONDS=10800
TMP_CLEANUP_MIN_AGE_SECONDS=21600

# ── Worker（分布式执行）──────────────────────────────────────────────
# 数据库节点身份一旦被 Task allocator 绑定就不能原地切换。
# Manager 部署保持 manager；Worker bootstrap 会自动写入 worker。
CCM_NODE_ROLE=manager           # manager | worker
WORKER_SSH_KEY_PATH=~/.ssh/ccm_worker_key  # Manager→Worker SSH 私钥路径（setup.sh 自动生成）

# ── 数据库自动备份（可选，BACKUP_ENABLED=true 时生效）──────────────────────────
BACKUP_ENABLED=false
BACKUP_TYPE=local               # local | s3 | oss
BACKUP_INTERVAL_SECONDS=3600   # 备份间隔（秒），默认 1 小时
BACKUP_MAX_COPIES=10           # 保留的最大备份份数
BACKUP_TEMP_DIR=               # 归档临时目录（避免占满 /tmp），例如 /home/ubuntu/.cache/claude-manager-backup-tmp

# local 后端（BACKUP_TYPE=local）
BACKUP_DESTINATION_PATH=        # 备份目标目录，例如 /mnt/backup/claude-manager（使用绝对路径，~ 会自动展开）

# AWS S3 后端（BACKUP_TYPE=s3）
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# 阿里云 OSS 后端（BACKUP_TYPE=oss）
BACKUP_OSS_ENDPOINT=            # 例如 oss-cn-hangzhou.aliyuncs.com
BACKUP_OSS_BUCKET=
BACKUP_OSS_ACCESS_KEY=
BACKUP_OSS_SECRET_KEY=
